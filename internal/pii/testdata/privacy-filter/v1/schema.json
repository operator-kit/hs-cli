{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://operator-kit.example/schemas/privacy-filter-corpus-v1.json",
  "title": "hs-cli synthetic typed privacy corpus v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "partition", "cases"],
  "properties": {
    "schema": {"const": 1},
    "partition": {
      "enum": [
        "secrets",
        "people-third-parties",
        "account-identifiers",
        "private-public-dates",
        "addresses",
        "emails-phones-urls",
        "obfuscated-messy-pii",
        "multilingual",
        "preservation",
        "long-input",
        "command-output-payloads"
      ]
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "language",
        "script",
        "shape",
        "risk",
        "reason",
        "text",
        "known_identities",
        "targets",
        "outputs",
        "tags"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "language": {"type": "string", "minLength": 2},
        "script": {
          "enum": ["Latin", "Arabic", "Han", "Hiragana", "Hangul", "Devanagari", "Common", "Mixed"]
        },
        "shape": {
          "enum": [
            "prose",
            "json",
            "yaml",
            "shell",
            "url",
            "markdown",
            "html",
            "quoted-reply",
            "log",
            "stack-trace",
            "code",
            "signature",
            "long-thread",
            "command-payload"
          ]
        },
        "risk": {"enum": ["critical", "high", "standard", "preservation"]},
        "reason": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "known_identities": {
          "type": "array",
          "items": {"$ref": "#/$defs/knownIdentity"}
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/target"}
        },
        "outputs": {"$ref": "#/$defs/modeOutputs"},
        "tags": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "secret_fixture": {"$ref": "#/$defs/secretFixture"}
      }
    },
    "knownIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "first", "last", "email", "phone"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "type": {"enum": ["customer", "user"]},
        "first": {"type": "string"},
        "last": {"type": "string"},
        "email": {"type": "string"},
        "phone": {"type": "string"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "start", "end", "value", "match", "actions"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "kind": {
          "enum": ["person", "address", "email", "phone", "url", "private_date", "account_number", "secret"]
        },
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1},
        "value": {"type": "string", "minLength": 1},
        "match": {"enum": ["exact", "covering"]},
        "identity_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
		"synthetic": {"$ref": "#/$defs/syntheticProvenance"},
        "actions": {"$ref": "#/$defs/modeActions"}
      }
    },
	"syntheticProvenance": {
	  "type": "object",
	  "additionalProperties": false,
	  "required": ["generator", "version", "seed", "recipe", "purpose"],
	  "properties": {
		"generator": {"const": "hs-privacy-structural"},
		"version": {"const": 1},
		"seed": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
		"recipe": {"type": "string", "minLength": 1},
		"purpose": {"enum": ["must-detect", "preserve"]}
	  }
	},
    "modeActions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["off", "customers", "all"],
      "properties": {
        "off": {"const": "preserve"},
        "customers": {"enum": ["preserve", "redact"]},
        "all": {"enum": ["preserve", "redact"]}
      }
    },
    "modeOutputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["off", "customers", "all"],
      "properties": {
        "off": {"$ref": "#/$defs/outputExpectation"},
        "customers": {"$ref": "#/$defs/outputExpectation"},
        "all": {"$ref": "#/$defs/outputExpectation"}
      }
    },
    "outputExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_absent", "required_present"],
      "properties": {
        "required_absent": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "required_present": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "secretFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "role"],
      "properties": {
        "family": {
          "enum": [
            "api-key",
            "access-token",
            "oauth-token",
            "password",
            "jwt",
            "one-time-code",
            "private-key",
            "database-connection",
            "cookie-authorization",
            "webhook-secret",
            "cloud-credential",
            "source-control-token",
            "payment-credential",
            "observability-token"
          ]
        },
        "role": {"enum": ["must-detect", "preserve"]}
      }
    }
  }
}
